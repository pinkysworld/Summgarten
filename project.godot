; Engine configuration file.
config_version=5

[application]

config/name="Klanggarten"
config/description="Dein Kind komponiert mit seiner eigenen Stimme."
config/version="2.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.53, 0.78, 0.93, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

driver/enable_input=true
general/ios/session_category=2

[autoload]

Audio="*res://scripts/audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.de.translation", "res://i18n/strings.en.translation", "res://i18n/strings.es.translation", "res://i18n/strings.fr.translation", "res://i18n/strings.ja.translation", "res://i18n/strings.pl.translation", "res://i18n/strings.pt_BR.translation", "res://i18n/strings.ru.translation", "res://i18n/strings.zh_CN.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.53, 0.78, 0.93, 1)
